# Phase 2 — Firebase config. Copy this file to .env.local (NOT .env.example)
# and fill in the real values from your Firebase project's "Your apps" page
# (Project settings -> general -> Your apps -> the </> web app icon).
# See Read_Me/FIREBASE_SETUP_GUIDE.md section 7 for exact steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
#
# Reminder (see Read_Me/PROJECT_PLAN.md "Security"): everything prefixed
# VITE_ is bundled into the public JS and visible to any site visitor.
# That is fine for Firebase's client config (it's designed to be public),
# but never put a real secret/admin key behind a VITE_ variable.
